# ---------------------------------------------------------------------------
# SCO Workbench configuration
#
# Copy to `.env`, fill in the SCO section, then `docker compose up -d --build`.
# NEVER commit the real .env (it is gitignored).
#
# Only what you normally need is here. Every other setting has a working default
# — backend/src/config/env.ts lists them all with their defaults.
# ---------------------------------------------------------------------------

# ===========================================================================
# 1. YOUR SCO INSTANCE  (required)
# ===========================================================================
# SCO_HOST: keep `host.docker.internal` when SCO runs on the SAME machine as
# the Workbench container — including when SCO is itself a container whose
# ports are published to that machine. Inside a container `localhost` is the
# container itself, so it would not reach SCO. If SCO runs elsewhere, put its
# hostname or IP here.
SCO_HOST=host.docker.internal

# SCO's web port (SCO + Atelier REST APIs) and superserver port (cube builds,
# production control). Both must be reachable from the machine running Docker.
SCO_WEB_PORT=52773
SCO_SUPERSERVER_PORT=1972

# The namespace you created for SCO — required, and there is no default. `SC` is
# only the value used in the examples; set yours.
SCO_NAMESPACE=SC

# The account the Workbench uses for every call to your instance. Grant it
# superuser privileges to unlock Workbench's full capabilities.
SCO_USER=superuser
SCO_PASSWORD=SYS

# ===========================================================================
# 2. AI ASSISTANT — pick ONE Claude provider  (optional)
# ===========================================================================
# ALL OF THIS IS OPTIONAL. With nothing set here the Workbench still boots and
# every non-AI feature works (data model, integration wizard, cubes, KPIs,
# dashboards, example data, connection tests) — only the AI-driven actions
# stand down, each saying so. Read the "AI Assistant" section of the README
# first: what it can change in your instance, and what data leaves it.
#
#   bedrock      Amazon Bedrock                  — inference in YOUR AWS account
#   anthropic    Anthropic Claude API (Console)  — inference at Anthropic
#   claude-aws   Claude Platform on AWS          — Anthropic's API, AWS auth + Marketplace billing
#   vertex       Google Cloud's Agent Platform (formerly Vertex AI)
#   foundry      Microsoft Foundry (Azure)
#
# Name your provider explicitly. A misconfiguration then reports the provider
# you MEANT — and names ITS variables — instead of falling through to another.
CLAUDE_PROVIDER=bedrock

# Required with any provider. The FORM is provider-specific — see each block.
ANTHROPIC_MODEL=us.anthropic.claude-sonnet-4-6

# ---- bedrock: Amazon Bedrock ----------------------------------------------
# ANTHROPIC_MODEL is a Bedrock inference-profile id; cross-region profiles carry
# a geography prefix (us. / eu. / apac. / global.):
#   ANTHROPIC_MODEL=us.anthropic.claude-sonnet-4-6
CLAUDE_CODE_USE_BEDROCK=1
AWS_REGION=us-east-1
# Credentials: ONE of the following. An IAM role attached to the container also
# counts and needs nothing set here.
# Option A — a Bedrock API key (simplest for a single account):
AWS_BEARER_TOKEN_BEDROCK=
# Option B — a static access key (session token optional):
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# Option C — a named profile from ~/.aws:
# AWS_PROFILE=

# ---- anthropic: Anthropic Claude API -------------------------------------
# Set CLAUDE_PROVIDER=anthropic and comment out CLAUDE_CODE_USE_BEDROCK above
# (a provider flag outranks a bare key, so leaving it at 1 would keep Bedrock).
# ANTHROPIC_MODEL is a plain Claude model id:
#   ANTHROPIC_MODEL=claude-sonnet-4-6
# A Console API key:
# ANTHROPIC_API_KEY=sk-ant-...
# ...OR a bearer token, for a gateway that does not take an Anthropic key:
# ANTHROPIC_AUTH_TOKEN=

# ---- claude-aws: Claude Platform on AWS ----------------------------------
# Anthropic's API with AWS auth and Marketplace billing, so it uses the SAME
# model ids as the direct Claude API — not Bedrock profile ids:
#   ANTHROPIC_MODEL=claude-sonnet-5
# Set CLAUDE_PROVIDER=claude-aws and comment out CLAUDE_CODE_USE_BEDROCK.
# CLAUDE_CODE_USE_ANTHROPIC_AWS=1
# REQUIRED — not implied by your AWS credentials; requests without it are rejected:
# ANTHROPIC_AWS_WORKSPACE_ID=wrkspc_01ABCDEFGHIJKLMN
# AWS_REGION=us-east-1
# Auth: a workspace API key (takes precedence), or leave it unset to sign with
# SigV4 from the standard AWS credential chain.
# ANTHROPIC_AWS_API_KEY=sk-ant-...

# ---- vertex: Google Cloud's Agent Platform -------------------------------
# Set CLAUDE_PROVIDER=vertex and comment out CLAUDE_CODE_USE_BEDROCK.
# ANTHROPIC_MODEL is a Vertex model id:
#   ANTHROPIC_MODEL=claude-sonnet-4-6
# CLAUDE_CODE_USE_VERTEX=1
# The project requests are addressed to (required):
# ANTHROPIC_VERTEX_PROJECT_ID=my-gcp-project
# `global`, a multi-region (us, eu), or a region (us-east5). Model availability
# differs — a "model not found" 404 usually means the wrong endpoint type.
# CLOUD_ML_REGION=global
# Credentials come from the Application Default Credentials chain, so normally
# set NOTHING here. Point at a key file only if you must:
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/key.json

# ---- foundry: Microsoft Foundry (Azure) ----------------------------------
# Set CLAUDE_PROVIDER=foundry and comment out CLAUDE_CODE_USE_BEDROCK.
# ANTHROPIC_MODEL is the Azure DEPLOYMENT NAME you chose — NOT a model id:
#   ANTHROPIC_MODEL=my-sonnet-deployment
# CLAUDE_CODE_USE_FOUNDRY=1
# Your Foundry resource name; the endpoint URL is built from it. A leftover
# placeholder points at a host that does not exist, which shows up as repeated
# connection errors on the first message.
# ANTHROPIC_FOUNDRY_RESOURCE=my-foundry-resource
# Auth: the resource's API key, an Entra ID bearer token, or neither — in which
# case the Azure default credential chain is used (az login / managed identity).
# ANTHROPIC_FOUNDRY_API_KEY=
# ANTHROPIC_FOUNDRY_AUTH_TOKEN=

# ===========================================================================
# 3. OPTIONAL TWEAKS
# ===========================================================================
# Where uploaded CSVs and SSH keys are materialized INSIDE YOUR SCO container
# at Deploy. They must be writable by the SCO process. The /tmp defaults are
# usually cleared when SCO restarts, so files have to be re-uploaded after one;
# point these at a persistent directory to avoid that.
# SCO_UPLOAD_CSV_DIR=/tmp/sco-workbench/csv
# SCO_UPLOAD_KEY_DIR=/tmp/sco-workbench/keys

# Maximum agentic turns for ONE user message (default 100) — bounds a
# non-converging AI turn. Raise it only if a legitimate flow needs more.
# AGENT_MAX_TURNS=100
